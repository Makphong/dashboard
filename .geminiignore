# AI Ignore Rules
# Purpose: prevent AI from spending input tokens on non-essential files.
# Syntax follows gitignore-style patterns.

docs/

# VCS and editor metadata
.git/
.vscode/
.idea/
*.code-workspace

# Python cache and virtual environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Node/package artifacts (future-safe)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and coverage outputs
build/
dist/
out/
.next/
.cache/
coverage/
*.map

# Local databases and large data artifacts
local_dashboard.db
artifacts
data/*.db
*.db
*.sqlite
*.sqlite3
*.parquet
*.feather

# Binary/media assets (usually not needed for logic reasoning)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.ico
*.svg
*.mp4
*.mov
*.avi
*.webm

# Archives/binaries
*.zip
*.tar
*.gz
*.7z
*.rar
*.exe
*.dll
*.so
*.dylib
*.bin

# Runtime temp/log folders
logs/
tmp/
temp/
*.log

# Deployment metadata
.vercel/
