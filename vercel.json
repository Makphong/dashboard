{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/frontend/src/app.jsx",
      "dest": "/api/index.py"
    },
    {
      "src": "/frontend/src/(.*\\.(?:js|jsx|mjs|css|json|map))",
      "dest": "/frontend/src/$1"
    },
    {
      "src": "/fonts/(.*\\.ttf)",
      "dest": "/frontend/public/fonts/$1"
    },
    {
      "src": "/(favicon\\.ico|robots\\.txt|manifest\\.webmanifest)",
      "dest": "/frontend/public/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/public/index.html"
    }
  ]
}
