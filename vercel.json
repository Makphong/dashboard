{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/frontend/src/app.jsx",
      "dest": "/frontend/src/app.jsx"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
