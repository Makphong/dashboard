{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/frontend/src/app.jsx",
      "dest": "/frontend/src/app.jsx"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
